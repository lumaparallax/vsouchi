<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ui_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rootless Virtual Device Nodes for Linux on Android"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_primary"
            android:paddingTop="2dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Virtual Nodes:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• V4L2 Subsystem (/dev/video0)"
            android:textSize="14sp"
            android:textColor="@color/ui_accent"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This service operates headlessly when triggered from a shell daemon."
            android:textSize="14sp"
            android:textColor="@color/ui_text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ui_card"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
